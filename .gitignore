# Claude Code: the agent + command definitions are part of the project — they
# are *how* it is built, and the README points readers at them. Machine-local
# settings and worktree checkouts under .claude/ stay ignored.
.claude/*
!.claude/agents/
!.claude/commands/

# Dart/Flutter tooling cache
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies

# Build output
build/

# Generated plugin registrants / ephemeral platform dirs
**/generated_plugin_registrant.*
**/ios/Flutter/ephemeral/
**/android/.gradle/
**/android/local.properties
.gradle/
local.properties

# IDE
.idea/
*.iml
.vscode/

# Release signing (never commit — see docs/superpowers/specs/2026-08-20-fdroid-self-hosted-repo-design.md)
android/key.properties
*.keystore
*.jks
*.p12

docs/
.superpowers/

# Blender backup files
*.blend1

# Gameplay video/GIF: regenerated locally by tools/video/capture_gameplay.py
# and uploaded to YouTube rather than committed, to keep large binaries out
# of the repo. Re-run the script to reproduce it locally when needed.
# media/* (not media/) so the negation below can still track one file inside
# the directory -- a negation cannot rescue a path inside an excluded dir.
media/*
# The poster frame is the exception: the README links it (GitHub can't embed
# the YouTube-hosted video inline), so it's committed while gameplay.mp4/.gif
# stay ignored.
!media/gameplay_thumbnail.png

# Python bytecode cache (tools/)
__pycache__/
*.pyc
